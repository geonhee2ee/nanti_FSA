# This file provides a way to think about the stress pattern of Nanti
# with a finite state acceptor.

# This part defines the symbols. Note a capital letter indicates a
# stressed syllable and a lowercase letter indicates an unstressed
# one.

=A{/A} =a{/a} =As{/As}
=B{/B} =b{/b} =Bs{/Bs}
	

=P{/P} =p{/p} #p is the prosodic boundary

# The following defines natural classes by weight/prominence. So A/a
# are the least prominent syllables and L/l are the most prominent
# syllables.

=w01 \/{%||%<A>, %||%<As>, %||%<a>}
=w02 \/{%||%<B>, %||%<Bs>, %||%<b>}


# Here are natural classes for stressed symbols and unstressed symbols.
# (Plebby will not recognize expressions split across multiple lines.)

=primary \/{%||%<As>, %||%<Bs>}
=head \/{%||%<A>, %||%<B>}
=unstressed \/{%||%<a>, %||%<b>}

# Trochees and iambic disyllabic feet are defined generally.

=trochee @{\/{head, primary}, unstressed}

=iamb @{unstressed, \/{head, primary}}



# In Nanti, we care whether the left or right syllable in a foot is
# more prominent. `promleft` is all disyllabic feet where the left
# syllable is more prominent than the right syllable.

=promleft @{w02, w01}

# `promright` is all disyllabic feet where the right syllable is more
# prominent than the left one.

=promright -promleft # note `-` means 'reverse it' in plebby


# Finally here are all the disyllabic feet in plebby where the
# syllables have equal prominence.

=promeq  \/{@{w02, w02}, @{w01, w01}}

# Typical trochees in Nanti are trochees with the leftmost syllable
# stressed.
=goodTrochee /\{promleft, trochee}
=badTrochee /\{promright, trochee}

# Typical iambs in Nanti are trochees with the rightmost syllable
# stressed.
=goodIamb /\{promright, iamb}
=badIamb /\{promleft, iamb}

# When the two syllables have equal prominence, they can be either
# trochees or iambs. It depends on their distribution.

=eqpromTrochee /\{promeq,trochee}
=eqpromIamb /\{promeq,iamb}


# Next we want to build an acceptor using `goodTrochee`, `goodIamb`, `eqpromTrochee`, and `eqpromIamb`.


# The last part looks like this.

=ending @{%||%<p>, *unstressed}

#All the possible combination of feet in a word (the so-called Sigma-star)

# for one-footed words as they can be badTrochee where the prominence is Iamb but the stress is assigned to Trochee (As b)] due to no stress in the ultima 

=foot \/{eqpromTrochee, goodTrochee, badTrochee, badIamb, goodIamb, eqpromIamb}
=sigma *foot

# for the rest of cases where they are two or more feet in a prosodic word boundary

=footprwd \/{eqpromTrochee, goodTrochee, goodIamb, eqpromIamb}
=sigmaprwd *footprwd

###################################################################

=sigmaprwdinitial @{%||%<P>, *footprwd}

=btwgoodIambgoodTrochee @{sigmaprwdinitial, goodIamb, *eqpromIamb, eqpromTrochee, *eqpromIamb, goodTrochee}

=InitialEqpromTrochee @{%||%<P>, eqpromTrochee, goodIamb}

=FinalIamb @{\/{goodIamb, eqpromIamb}, %||%<p>}# need to put this somewhere 

=Clash @{sigmaprwdinitial, eqpromIamb, *\/{eqpromTrochee, goodTrochee}}
=ClashInitial @{%||%<P>, eqpromIamb, +\/{eqpromTrochee, goodTrochee}}
#=ClashGoodTrocheeIamb @{%||%<P>, goodTrochee, eqpromIamb, *footprwd}

=goodTrocheeHead /\{goodTrochee, @{head, unstressed}}
=ClashGoodTrocheeIamb @{%||%<P>, goodTrocheeHead, eqpromIamb, *footprwd}

=ValidWords2 /\{sigmaprwd, !btwgoodIambgoodTrochee, !Clash}
=ValidWordsFinal /\{!InitialEqpromTrochee,  @{sigmaprwdinitial, sigmaprwd}, !btwgoodIambgoodTrochee, !ClashInitial, !ClashGoodTrocheeIamb}





###################################################################
################## NEW stress assignment ###########################

# Word-level primary stress condition: only one 
# primary stress in a word

# Blocks two occurrences of the same primary stress marker
=notwosameprimary /\{~<As, As>, ~<Bs, Bs>} 

# Blocks two different primary stress markers from co-occurring
=notwodiffprimary ~<As, Bs>

# prominence restriction: the syllable X is the most prominent, 
# then that becomes primary stress. If there are same prominent heads, then the rightmost one becomes primary

# If As is primary, no other stress head (A, B, C) or higher 
# prominence unstressed (b, c) appears anywhere in the word, 
# and As is the rightmost A
=prominentA /\{~<As, A>, ~<As, B>, ~<As, b>, ~<b, As>, ~<B, As>} 

# If Bs is primary: no C-level symbol appears anywhere, and 
# Bs is the rightmost B
=prominentB /\{~<Bs, B>}

# If A is the prominence ceiling: no higher prominence symbol (B, C, b, c) 
# follows any A
=noHigherAfterA /\{~<A, B>, ~<A, b>}

# A is the ceiling: no symbol from {B, C, b, c} appears anywhere 
# relative to A (symmetric)
=noHigherAnywhereA /\{noHigherAfterA, -noHigherAfterA}

# B is the ceiling: no restrictions since B is the top of 
# the prominence scale -- accepts any string
=noHigherAnywhereB *\/{%||%<A>, %||%<a>, %||%<B>, %||%<b>, %||%<Bs>,  %||%<P>, %||%<p>}

# Selects the appropriate prominence ceiling context for 
# the word--depending on the primary stress, it should have 
# different conditions for each primary stress level, defined under Union
=prominencecontext \/{noHigherAnywhereA, noHigherAnywhereB}

# This is for the stress configuration of a word
# there should be at least one foot with primary stress 
# and then the rest of feet with secondary stresses 
=trocheeprimary @{primary, unstressed}
=trocheeprimaryStrict /\{promleft, @{primary, unstressed}}
=iambprimary @{unstressed, primary}
=trocheehead @{head, unstressed}
=iambhead @{unstressed, head}

# This is that there are zero or more feet with secondary stress 
# before and after the foot with primary stress 
# A prosodic word has zero or more secondary feet, 
# exactly one primary foot, zero or more secondary feet, 
# and optionally trailing unstressed syllables
=haveprimary @{sigmaprwdinitial, */\{sigmaprwd,\/{trocheehead, iambhead}}, \/{trocheeprimary, iambprimary}, */\{sigmaprwd, \/{trocheehead, iambhead}},*unstressed}
=haveprimaryStrict @{sigmaprwdinitial, */\{sigmaprwdinitial,\/{trocheehead, iambhead}}, \/{trocheeprimaryStrict, iambprimary}, */\{sigmaprwd, \/{trocheehead, iambhead}}, *unstressed}

#This predicate includes all the constraints for the stress assginment 
=newprimary /\{notwosameprimary, notwodiffprimary, -notwodiffprimary, prominentA, prominentB, prominencecontext, haveprimary}
=newprimaryStrict /\{notwosameprimary, notwodiffprimary, -notwodiffprimary, prominentA, prominentB, prominencecontext, haveprimaryStrict}
##############################################################


# Type 1: stress in a word that has one foot e.g., (A a)]
# in a one-foot length word, the first syllable is stressed 
=singlefoot \/{goodTrochee, eqpromTrochee, badTrochee}
=oneWordPrimary /\{@{primary, unstressed}, singlefoot}
=oneWordFinal @{%||%<P>, oneWordPrimary, ending}

# Now let's compute the most prominent syllable and change it into the primary syllable 
# stress in a word that has odd number of syllables with equal prominence -- one unfooted syllable before pwrd 
#=OddEq +eqpromIamb
#=OddEqStress /\{OddEq, newprimary} # a A . a ]
#=OddEqStressFinal @{OddEqStress, unstressed, ending} #subsumed by OddNonEqStressFinal


# stress in a word that has odd number of syllables without equal prominence-- one unfooted syllable before pwrd 

=OddNonEqStress /\{newprimaryStrict, ValidWordsFinal}
=OddNonEqStressFinal @{OddNonEqStress, unstressed, ending}


# Type 2-2: even-number of syllables with exhaustive footing: 
# the penult is the strongest
#=EvenEq +eqpromTrochee #--subsumed by even3 
#=EvenEqStress /\{newprimary, EvenEq}#--subsumed by EvenNonEqStressFinal
#=EvenEqStressFinal @{Even1, ending}

# Type 2-3: if all syllables are the same prominence 
# in even-number of syllables without exhaustive footing: 
# the penult is not the strongest 

# noFinalFoot restricts the prominence of unfooted penult in non-exhaustive footing words and this is added for Even number of syllables with non-exhaustive footing 
# For instance, for a word "b B c Cs a a p", we only need to consider whether the penult is prominent than the primary stress. For that constraint, we have 'noFinalFoot' to allow not to have any prominent syllable in the penult (GL: I guess "noFinalFoot" won't work because they are already defined in one of the stress constraints
=noFinalFoot ~<As, b>
=newprimary2 /\{notwosameprimary, notwodiffprimary, -notwodiffprimary, prominentA, prominentB, prominencecontext, haveprimaryStrict, noFinalFoot}

#=EvenEqNoFinalFoot @{+eqpromIamb, unstressed}
#=EvenEqNoFinalFootStress /\{EvenEqNoFinalFoot, newprimary2}
#=EvenEqNoFinalFootFinal @{EvenEqNoFinalFootStress, unstressed, ending} #-subsumed by EvenNonEqNoFinalFoot

# Even case 1: exhaustive footing

=exactlyTwoFeet @{footprwd, footprwd}
=threeOrMoreFeet @{footprwd, footprwd, footprwd, *footprwd}

=penultExtraB /\{~<B, Bs>, ~<b, Bs>}
=penultExtraA /\{~<A, As>, ~<a, As>}
=penultExtrametrical /\{penultExtraA, penultExtraB}

=EvenNonEqTwoFeet /\{ValidWordsFinal, @{sigmaprwdinitial, exactlyTwoFeet}, penultExtrametrical}
=EvenNonEqThreeOrMoreFeet /\{ValidWordsFinal, @{sigmaprwdinitial, threeOrMoreFeet}}
=EvenNonEq \/{EvenNonEqTwoFeet, EvenNonEqThreeOrMoreFeet}
=EvenNonEqStress /\{newprimary, EvenNonEq}

=EvenNonEqStressFinal @{EvenNonEqStress, ending}


# Even case 2: non-exhaustive footing
=EvenNonEqNoFinalFoot @{ValidWordsFinal, unstressed}
=EvenNonEqNoFinalFootStress /\{newprimary2, EvenNonEqNoFinalFoot}
=EvenNonEqNoFinalFootStressFinal @{EvenNonEqNoFinalFootStress, unstressed, ending}

# Union the machine

=machine \/{oneWordFinal, OddNonEqStressFinal, EvenNonEqStressFinal, EvenNonEqNoFinalFootStressFinal}


